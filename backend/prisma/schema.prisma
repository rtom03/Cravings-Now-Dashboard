  foodicsId String @unique

  name      String?
  dialCode  Int?      @map("dial_code")
  phone     String?
  email     String?
  gender    Int? // 1 = Male, 2 = Female — small enough to enum if you'd like, flag if so
  birthDate DateTime? @map("birth_date") @db.Date

  houseAccountLimit     Int?    @map("house_account_limit") // scoped field (customers.accounts.read/write)
  houseAccountBalance   Float?  @map("house_account_balance") // scoped field (customers.accounts.read) — read-only
  loyaltyBalance        Float?  @map("loyalty_balance") // scoped field (customers.loyalty.read) — read-only
  isLoyaltyEnabled      Boolean @map("is_loyalty_enabled")
  isBlacklisted         Boolean @map("is_blacklisted")
  isHouseAccountEnabled Boolean @map("is_house_account_enabled")

  lastOrderAt DateTime? @map("last_order_at")
  orderCount  Int?      @map("order_count")

  // --- Relations ---

  tags      Tag[]             @relation("CustomerTags") // sample shows {id} only, no pivot -> plain many-to-many
  addresses CustomerAddress[] // inverse of CustomerAddress.customer (one-to-many)
  order     Order?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("customers")
}

model CustomerAddress {
  id        String @id @default(uuid())
  foodicsId String @unique

  name        String?
  description String?
  latitude    String?
  longitude   String?

  // --- Relations ---

  customerId String   @map("customer_id")
  customer   Customer @relation(fields: [customerId], references: [id])

  order Order?

  deliveryZoneId String?       @unique @map("delivery_zone_id")
  deliveryZone   DeliveryZone? @relation(fields: [deliveryZoneId], references: [id])

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("customer_addresses")
}

model GiftCardProduct {
  id        String @id @default(uuid())
  foodicsId String @unique

  name          String
  nameLocalized String?       @map("name_localized")
  image         String?
  sku           String        @unique
  barcode       String?
  pricingMethod PricingMethod @map("pricing_method") // now correctly using the enum (1=FIXED_PRICE, 2=OPEN_PRICE)
  price         Float
  isActive      Boolean?      @map("is_active")

  // --- Relations ---

  categoryId String   @unique @map("category_id")
  category   Category @relation(fields: [categoryId], references: [id])

  tags   Tag[]       @relation("GiftCardProductTags") // pivot: {gift_card_product_id, tag_id} only -> plain many-to-many
  groups MenuGroup[] @relation("MenuGroupGiftCardProducts") // pivot: {gift_card_product_id, group_id} only -> plain many-to-many

  branches GiftCardProductBranch[] // pivot: {gift_card_product_id, branch_id, is_active} -> real extra field -> explicit pivot
  giftCard GiftCard?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("gift_card_products")
}

model GiftCardProductBranch {
  id String @id @default(uuid())

  giftCardProductId String          @map("gift_card_product_id")
  giftCardProduct   GiftCardProduct @relation(fields: [giftCardProductId], references: [id])

  branchId String  @unique @map("branch_id")
  branch   Branch? @relation(fields: [branchId], references: [id])

  isActive Boolean? @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([giftCardProductId, branchId])
  @@map("gift_card_product_branches")
}

model GiftCard {
  id        String @id @default(uuid())
  foodicsId String @unique

  amount  Float
  balance Float
  code    String?

  // --- Relations ---

  orderId String? @map("order_id")
  order   Order?

  giftCardProductId String          @unique @map("gift_card_product_id")
  giftCardProduct   GiftCardProduct @relation(fields: [giftCardProductId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("gift_cards")
}

model Coupon {
  id        String @id @default(uuid())
  foodicsId String @unique

  name        String
  code        String   @unique
  maximumUses Int      @map("maximum_uses")
  isActive    Boolean? @map("is_active")

  fromDate DateTime @map("from_date") @db.Date
  toDate   DateTime @map("to_date") @db.Date
  fromTime Int      @map("from_time") // hour 0-23, same pattern as Promotion/TimedEvent
  toTime   Int      @map("to_time")

  isSat Boolean? @map("is_sat")
  isSun Boolean? @map("is_sun")
  isMon Boolean? @map("is_mon")
  isTue Boolean? @map("is_tue")
  isWed Boolean? @map("is_wed")
  isThu Boolean? @map("is_thu")
  isFri Boolean? @map("is_fri")

  // --- Relations ---

  discountId String   @unique @map("discount_id")
  order      Order?
  discount   Discount @relation(fields: [discountId], references: [id])

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("coupons")
}

model PaymentMethod {
  id        String @id @default(uuid())
  foodicsId String @unique

  name           String
  nameLocalized  String?           @map("name_localized")
  code           String?
  autoOpenDrawer Boolean?          @map("auto_open_drawer")
  type           PaymentMethodType
  isActive       Boolean?          @map("is_active")
  index          Int?

  // --- Relations ---

  payments OrderPayment[] // inverse of OrderPayment.paymentMethod

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("payment_methods")
}

enum PaymentMethodType {
  CASH // 1
  CARD // 2
  OTHER // 3
  GIFT_CARD // 4
  HOUSE_ACCOUNT // 5
  THIRD_PARTY // 7
}

enum ConditionType {
  QUANTITY_BASED // 1
  SPENDING_BASED // 2
}

enum PromotionType {
  BASIC // 1
  ADVANCED // 2
}

enum RewardType {
  PERCENTAGE_DISCOUNT_ON_PRODUCTS // 1
  AMOUNT_DISCOUNT_ON_PRODUCTS // 2
  PERCENTAGE_DISCOUNT_ON_ORDER // 3
  AMOUNT_DISCOUNT_ON_ORDER // 4
  FIXED_PRICE // 5
}

enum TagType {
  CUSTOMER_TAG // 1
  BRANCH_TAG // 2
  INVENTORY_ITEM_TAG // 3
  ORDER_TAG // 4
  SUPPLIER_TAG // 5
  USER_TAG // 6
  PRODUCT_TAG // 7
  DEVICE_TAG // 8
  REVENUE_CENTER_TAG // 9
}

enum OrderType {
  DINE_IN // 1
  PICK_UP // 2
  DELIVERY // 3
  DRIVE_THRU // 4
}

enum ChargeType {
  AMOUNT // 1
  PERCENTAGE // 2
}

enum TableStatus {
  FREE // 1
  OCCUPIED // 2
  CHECK_PRINTED // 3
  RESERVED // 4
}

enum DeviceType {
  CASHIER // 1
  KDS // 2
  NOTIFIER // 4
  DISPLAY // 5
  SUB_CASHIER // 6
  FOODICS_ONE_CASHIER // 7
  WAITER // 8
