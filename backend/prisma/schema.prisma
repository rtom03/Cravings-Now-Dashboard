  voiderId String? @unique @map("voider_id")
  voider   User?   @relation("OrderProductVoider", fields: [voiderId], references: [id])

  promotionId String?    @unique @map("promotion_id")
  promotion   Promotion? @relation("OrderProductPromotion", fields: [promotionId], references: [id])

  timedEvents TimedEvent[] @relation("OrderProductTimedEvents") // no pivot data shown -> plain relation

  taxes   OrderProductTax[]
  options OrderProductOption[]

  @@map("order_products")
}

// pivot: {amount, rate, tax_exclusive_discount_amount} — same real-data pattern as OrderTax
model OrderProductTax {
