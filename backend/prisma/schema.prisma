  totalCost                  Float     @map("total_cost")
  taxExclusiveDiscountAmount Float     @map("tax_exclusive_discount_amount")
  taxExclusiveUnitPrice      Float     @map("tax_exclusive_unit_price")
  taxExclusiveTotalPrice     Float     @map("tax_exclusive_total_price")
  status                     Int // Product Status enum — values not yet given
  isIngredientsWasted        Boolean   @map("is_ingredients_wasted")
  isIngredientsReturned      Boolean   @map("is_ingredients_returned")
  delayInSeconds             Int?      @map("delay_in_seconds")
  kitchenNotes               String?   @map("kitchen_notes")
