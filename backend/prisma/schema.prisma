// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                       String             @id @default(uuid())
  email                    String             @unique
  password                 String
  name                     String?
  branchId                 String?
  role                     UserRole
  branch                   Branch?            @relation(fields: [branchId], references: [id])
  creator                  Order?             @relation("OrderCreator")
  closer                   Order?             @relation("OrderCloser")
  driver                   Order?             @relation("OrderDriver")
  orderProductCreator      OrderProduct?      @relation("OrderProductCreator")
  orderProductVoider       OrderProduct?      @relation("OrderProductVoider")
  orderPayment             OrderPayment?
  orderComboProductCreator OrderComboProduct? @relation("OrderComboProductCreator")
  orderComboProductVoider  OrderComboProduct? @relation("OrderComboProductVoider")

  @@index([role])
  @@index([branchId])
}

model Branch {
  id                    String  @id @unique @default(uuid())
  foodicsId             String  @unique @map("foodics_id")
  nameLocalized         String? @map("name_localized")
  reference             String? @unique @map("reference")
  name                  String
  latitude              String?
  longitude             String?
  phone                 String?
  openingFrom           String  @map("opening_from")
  openingTo             String  @map("opening_to")
  acceptsReservations   Boolean @default(false) @map("accepts_reservations")
  address               String?
  receiptFooter         String? @map("receipt_footer")
  receiptHeader         String? @map("receipt_header")
  reservationDuration   Int     @default(0) @map("reservation_duration")
  reservationTimes      Json?   @map("reservation_times")
  settings              Json
  // type                    Int
  inventoryEndOfDayTime String  @map("inventory_end_of_day_time")
  receivesOnlineOrders  Boolean @default(false) @map("receives_online_orders")

  // --- Relations ---

  taxGroupId String?   @map("tax_group_id")
  taxGroup   TaxGroup? @relation(fields: [taxGroupId], references: [id])

  branchCategories BranchCategory[]

  // brandId String
  // brand   Brand  @relation(fields: [brandId], references: [id])

  products             ProductBranch[]        @relation("BranchProducts")
  modifierOptionBranch ModifierOptionBranch[]

  // modifierOptions         ModifierOption[] @relation("BranchModifierOptions")
  combos        ComboBranch[]
  tags          Tag[]          @relation("BranchTags")
  users         User[]
  deliveryZones DeliveryZone[] @relation("BranchDeliveryZones")
  // discounts               BranchDiscount[] @relation("BranchDiscounts")
  timedEvents   TimedEvent[]   @relation("BranchTimedEvents")
  promotions    Promotion[]    @relation("BranchPromotions")
  charges       Charge[]       @relation("BranchCharges")
  discounts     Discount[]     @relation("DiscountBranches")

  inventoryItemBranch       InventoryItemBranch[]
  sections                  Section[]
  devices                   Device[]
  comboItemOptionSizeBranch ComboItemOptionSizeBranch[]
  orders                    Order[]
  giftCardProductBranch     GiftCardProductBranch?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("branches")
}

model Product {
  id                           String   @id @default(uuid())
  foodicsId                    String   @unique
  sku                          String   @unique
  barcode                      String?
  name                         String
  nameLocalized                String?  @map("name_localized")
  description                  String?
  descriptionLocalized         String?  @map("description_localized")
  image                        String?
  isActive                     Boolean  @default(true) @map("is_active")
  isStockProduct               Boolean  @default(false) @map("is_stock_product")
  isNonRevenue                 Boolean  @default(false) @map("is_non_revenue")
  isReady                      Boolean  @default(false) @map("is_ready")
  pricingMethod                Int      @map("pricing_method") // 1 = Pre Set, 2 = Open Price
  sellingMethod                Int      @map("selling_method") // 1 = Unit, 2 = Weight
  costingMethod                Int      @map("costing_method") // 1 = Fixed, 2 = From Ingredients
  preparationTime              Int?     @map("preparation_time")
  price                        Float?
  cost                         Float?
  calories                     Int?
  walkingMinutesToBurnCalories Int?     @map("walking_minutes_to_burn_calories")
  isHighSalt                   Boolean? @map("is_high_salt")

  // --- Relations ---

  taxGroupId               String?               @map("tax_group_id")
  taxGroup                 TaxGroup?             @relation(fields: [taxGroupId], references: [id])
  comboItemSize            ComboItemOptionSize[]
  categoryId               String?               @map("category_id")
  category                 Category?             @relation(fields: [categoryId], references: [id])
  promotion                Promotion[]           @relation("PromotionProducts")
  rewardPromotions         Promotion[]           @relation("PromotionRewardProducts")
  orderProduct             OrderProduct?
  orderComboProductProduct OrderComboProduct?    @relation("OrderComboProductProduct")

  tags        Tag[]        @relation("ProductTags")
  discounts   Discount[]   @relation("ProductDiscounts")
  timedEvents TimedEvent[] @relation("ProductTimedEvents")
  groups      MenuGroup[]  @relation("ProductMenuGroups")

  branches    ProductBranch[]
  ingredients ProductIngredient[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("products")
}

model Category {
  id        String @id @default(uuid())
  foodicsId String @unique

  name          String
  nameLocalized String? @map("name_localized")
  reference     String? @unique
  image         String?

  // --- Relations ---
  branchCategories BranchCategory[]

  items                   InventoryItem[]
  discounts               Discount[]       @relation("CategoryDiscounts")
  timedEvents             TimedEvent[]     @relation("CategoryTimedEvents")
  products                Product[] // inverse of Product.category (one-to-many)
  groupProducts           GroupProducts[]
  combos                  Combo[] // inverse of Combo.category (one-to-many)
  promotionCategory       Promotion[]      @relation("PromotionCategories")
  promotionRewardCategory Promotion[]      @relation("PromotionRewardCategories")
  giftCardProduct         GiftCardProduct?

  // giftCardProducts GiftCardProduct[] @relation("CategoryGiftCardProducts")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  // brandCategories BrandCategory[]

  @@map("categories")
}

model BranchCategory {
  id String @id @default(uuid())

  branchId   String
  categoryId String

  branch   Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([branchId, categoryId])
  @@map("branch_categories")
}

// Per-branch custom attribute overrides (price, cost, active state, etc.)
model ProductBranch {
  id String @id @default(uuid())

  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id])
  branchId  String  @map("branch_id")
  branch    Branch  @relation("BranchProducts", fields: [branchId], references: [id])

  price       Float?
  isActive    Boolean? @map("is_active")
  is_in_stock Boolean?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([productId, branchId])
  @@map("product_branches")
}

// Ingredients (BOM) — quantity of each inventory item used per product
model ProductIngredient {
  id String @id @default(uuid())

  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id])

  inventoryItemId String        @map("inventory_item_id")
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])

  quantity        Float?
  yieldPercentage Float

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([productId, inventoryItemId])
  @@map("product_ingredients")
}

model Group {
  id            String          @id @unique @default(uuid())
  foodicsId     String          @unique
  name          String
  nameLocalized String?
  image         String?
  group         GroupProducts[]
}

model GroupProducts {
  id                           String                 @id @default(uuid())
  foodicsId                    String                 @unique
  sku                          String
  group_name                   String?
  barcode                      String?
  name                         String
  nameLocalized                String?                @map("name_localized")
  description                  String?
  descriptionLocalized         String?                @map("description_localized")
  image                        String?
  isActive                     Boolean?               @default(true) @map("is_active")
  isStockProduct               Boolean?               @default(false) @map("is_stock_product")
  isNonRevenue                 Boolean?               @default(false) @map("is_non_revenue")
  isReady                      Boolean?               @default(false) @map("is_ready")
  pricingMethod                Int                    @map("pricing_method") // 1 = Pre Set, 2 = Open Price
  sellingMethod                Int                    @map("selling_method") // 1 = Unit, 2 = Weight
  costingMethod                Int                    @map("costing_method") // 1 = Fixed, 2 = From Ingredients
  preparationTime              Int?                   @map("preparation_time")
  price                        Float?
  cost                         Float?
  calories                     Int?
  walkingMinutesToBurnCalories Int?                   @map("walking_minutes_to_burn_calories")
  isHighSalt                   Boolean?               @map("is_high_salt")
  pivot                        Json?
  groupId                      String?
  group                        Group?                 @relation(fields: [groupId], references: [id])
  categoryId                   String?                @map("category_id")
  category                     Category?              @relation(fields: [categoryId], references: [id])
  groupProductModifiers        GroupProductModifier[]
}

model Modifier {
  id        String @id @default(uuid())
  foodicsId String @unique

  name          String
  nameLocalized String?
  reference     String?
  isReady       Boolean?

  createdAt DateTime?
  updatedAt DateTime?
  deletedAt DateTime?

  options  ModifierOptionModifier[]
  products GroupProductModifier[]
}

model ModifierOption {
  id            String  @id @default(uuid())
  foodicsId     String  @unique
  sku           String  @unique
  name          String
  image         String?
  nameLocalized String? @map("name_localized")
  isActive      Boolean @default(true) @map("is_active")
  isInStock     Boolean @default(true) @map("is_in_stock")
  costingMethod Int     @map("costing_method")
  price         Float
  cost          Float?
  calories      Float?
  index         Int?

  // --- Relations ---

  taxGroupId                String?                    @map("tax_group_id")
  taxGroup                  TaxGroup?                  @relation(fields: [taxGroupId], references: [id])
  createdAt                 DateTime                   @default(now()) @map("created_at")
  updatedAt                 DateTime                   @updatedAt @map("updated_at")
  deletedAt                 DateTime?                  @map("deleted_at")
  orderProductOption        OrderProductOption?
  orderComboProductOption   OrderComboProductOption?
  modifiers                 ModifierOptionModifier[]
  branches                  ModifierOptionBranch[]
  modifierOptionIngredients ModifierOptionIngredient[]

  @@map("modifier_options")
}

model ModifierOptionBranch {
  modifierOptionId String
  branchId         String

  price     Float?
  isActive  Boolean
  isInStock Boolean

  modifierOption ModifierOption @relation(fields: [modifierOptionId], references: [id], onDelete: Cascade)

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([modifierOptionId, branchId])
}

model ModifierOptionModifier {
  modifierId       String
  modifierOptionId String

  modifier       Modifier       @relation(fields: [modifierId], references: [id], onDelete: Cascade)
  modifierOption ModifierOption @relation(fields: [modifierOptionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([modifierId, modifierOptionId])
}

///the relationship between products and it modifier[]
model GroupProductModifier {
  groupProductId String
  modifierId     String

  isSplittableInHalf Boolean?
  uniqueOptions      Boolean?
  minimumOptions     Int?
  maximumOptions     Int?
  freeOptions        Int?

  defaultOptionsIds  Json?
  excludedOptionsIds Json?

  index Int?

  groupProduct GroupProducts @relation(fields: [groupProductId], references: [id], onDelete: Cascade)

  modifier Modifier @relation(fields: [modifierId], references: [id], onDelete: Cascade)

  @@id([groupProductId, modifierId])
}

// Pivot model for branches, since a modifier option can have
// custom attributes (e.g. price/cost override) per branch

// Pivot model for ingredients (inventory items), typically
// carrying a quantity/unit used per modifier option
model ModifierOptionIngredient {
  id String @id @default(uuid())

  modifierOptionId String         @map("modifier_option_id")
  modifierOption   ModifierOption @relation(fields: [modifierOptionId], references: [id])

  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])

  quantity Float?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([modifierOptionId, inventoryItemId])
  @@map("modifier_option_ingredients")
}

model InventoryItem {
  id                        String        @id @default(uuid())
  foodicsId                 String        @unique
  sku                       String        @unique
  barcode                   String?
  name                      String
  nameLocalized             String?       @map("name_localized")
  minimumLevel              String?       @map("minimum_level")
  maximumLevel              String?       @map("maximum_level")
  parLevel                  String?       @map("par_level")
  storageUnit               String        @map("storage_unit")
  ingredientUnit            Int           @map("ingredient_unit") // unit type code, enum values not given yet
  storageToIngredientFactor Float         @map("storage_to_ingredient_factor")
  costingMethod             CostingMethod @map("costing_method")
  cost                      Float?
  isProduct                 Boolean?      @map("is_product")
  yieldPercentage           Float?        @map("yield_percentage")

  // --- Relations ---
  ingredients              ProductIngredient[]
  tags                     Tag[]                      @relation("InventoryItemTags") // pivot is plain {inventory_item_id, tag_id} -> no custom attrs
  branches                 InventoryItemBranch[] // pivot HAS min/max/par overrides -> explicit pivot
  modifierOptionIngredient ModifierOptionIngredient[]

  categoryId String?   @map("category_id")
  category   Category? @relation(fields: [categoryId], references: [id])

  suppliers InventoryItemSupplier[] // pivot HAS order_unit/cost/etc -> explicit pivot

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("inventory_items")
}

// Per-branch custom stock levels
model InventoryItemBranch {
  id String @id @default(uuid())

  inventoryItemId String        @map("inventory_item_id")
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])

  branchId String @map("branch_id")
  branch   Branch @relation(fields: [branchId], references: [id])

  // pivot data
  minimumLevel String? @map("minimum_level")
  maximumLevel String? @map("maximum_level")
  parLevel     String? @map("par_level")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([inventoryItemId, branchId])
  @@map("inventory_item_branches")
}

// Supplier-specific ordering info for this inventory item
model InventoryItemSupplier {
  id String @id @default(uuid())

  inventoryItemId String        @map("inventory_item_id")
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])

  supplierId String   @map("supplier_id")
  supplier   Supplier @relation(fields: [supplierId], references: [id])

  // pivot data
  inventoryPivotItemId String
  orderUnit            String? @map("order_unit")
  orderToStorageFactor Float?  @map("order_to_storage_factor")
  minimumOrderQuantity Float?  @map("minimum_order_quantity")
  cost                 Float?
  code                 String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([inventoryItemId, supplierId])
  @@map("inventory_item_suppliers")
}

model Supplier {
  id        String @id @default(uuid())
  foodicsId String @unique

  name        String
  contactName String? @map("contact_name")
  phone       String?
  code        String?
  email       String?

  // --- Relations ---

  items InventoryItemSupplier[] // same pivot built in the InventoryItem step
  tags  Tag[]                   @relation("SupplierTags") // no pivot shown -> plain many-to-many

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("suppliers")
}

model MenuGroup {
  id        String @id @default(uuid())
  foodicsId String @unique

  name          String
  nameLocalized String? @map("name_localized")
  image         String?
  itemsIndex    Json?   @map("items_index") // ordered array of ids, not a relation itself

  // --- Relations ---

  products         Product[]         @relation("ProductMenuGroups")
  combos           Combo[]           @relation("ComboMenuGroups")
  giftCardProducts GiftCardProduct[] @relation("MenuGroupGiftCardProducts")

  // self-referential: a group can have subgroups (also MenuGroups)
  parentId  String?     @map("parent_id")
  parent    MenuGroup?  @relation("MenuGroupSubgroups", fields: [parentId], references: [id])
  subgroups MenuGroup[] @relation("MenuGroupSubgroups")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("menu_groups")
}

model Combo {
  id        String @id @default(uuid())
  foodicsId String @unique

  sku                  String   @unique
  barcode              String?
  name                 String
  nameLocalized        String?  @map("name_localized")
  description          String?
  descriptionLocalized String?  @map("description_localized")
  image                String?
  isActive             Boolean? @map("is_active")
  isReady              Boolean? @map("is_ready")

  categoryId String   @map("category_id")
  category   Category @relation(fields: [categoryId], references: [id])

  groups                MenuGroup[]  @relation("ComboMenuGroups") // pivot: {id} only -> plain
  tags                  Tag[]        @relation("ComboTags") // pivot: {combo_id, tag_id} only -> plain
  timedEvents           TimedEvent[] @relation("ComboTimedEvents") // pivot: {id} only -> plain
  promotionCombo        Promotion[]  @relation("PromotionCombos")
  promotionRewardsCombo Promotion[]  @relation("PromotionRewardCombos")

  branches ComboBranch[] // REINSTATED: pivot has {is_active} -> real data, explicit pivot

  sizes    ComboSize[]
  items    ComboItem[]
  discount Discount[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("combos")
}

model ComboBranch {
  id       String   @id @default(uuid())
  comboId  String   @map("combo_id")
  combo    Combo    @relation(fields: [comboId], references: [id])
  branchId String   @map("branch_id")
  branch   Branch   @relation(fields: [branchId], references: [id])
  isActive Boolean? @map("is_active")

  @@unique([comboId, branchId])
  @@map("combo_branches")
}

model ComboSize {
  id String @id @default(uuid())

  name          String
  nameLocalized String? @map("name_localized")

  comboId String @map("combo_id")
  combo   Combo  @relation(fields: [comboId], references: [id])

  optionSizes           ComboItemOptionSize[]
  orderComboSize        OrderCombo?
  orderComboProductSize OrderComboProduct?    @relation("OrderComboProductSize")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("combo_sizes")
}

model ComboItem {
  id            String   @id @default(uuid())
  name          String
  nameLocalized String?  @map("name_localized")
  isUpgradable  Boolean? @map("is_upgradable") // confirmed by this spec, previously missing

  comboId String @map("combo_id")
  combo   Combo  @relation(fields: [comboId], references: [id])

  options ComboItemOption[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("combo_items")
}

model ComboItemOption {
  id            String  @id @default(uuid())
  name          String
  nameLocalized String? @map("name_localized")
  hid           String? // still unconfirmed meaning, carried over

  comboItemId String    @map("combo_item_id")
  comboItem   ComboItem @relation(fields: [comboItemId], references: [id])

  sizes              ComboItemOptionSize[]
  // priceTags      PriceTagComboOption[]
  orderComboProducts OrderComboProduct[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // NOTE: `index` field removed — was an earlier unconfirmed guess,
  // no spec or sample has ever shown it on this model

  @@map("combo_item_options")
}

// Matches doc section "Combo Item Option Size Attributes" exactly
model ComboItemOptionSize {
  comboItemOptionId String          @map("combo_item_option_id")
  comboItemOption   ComboItemOption @relation(fields: [comboItemOptionId], references: [id])

  comboSizeId String    @map("combo_size_id")
  comboSize   ComboSize @relation(fields: [comboSizeId], references: [id])

  price     Float
  productId String
  product   Product @relation(fields: [productId], references: [id])

  branches ComboItemOptionSizeBranch[]

  @@id([comboItemOptionId, comboSizeId])
  @@map("combo_item_option_sizes")
}

// pivot only carries `price` per the doc's own "branches.pivot.price" field
model ComboItemOptionSizeBranch {
  id                String              @id @default(uuid())
  comboItemOptionId String              @map("combo_item_option_id")
  comboSizeId       String              @map("combo_size_id")
  optionSize        ComboItemOptionSize @relation(fields: [comboItemOptionId, comboSizeId], references: [comboItemOptionId, comboSizeId])

  branchId String @map("branch_id")
  branch   Branch @relation(fields: [branchId], references: [id])

  price Float

  @@unique([comboItemOptionId, comboSizeId, branchId])
  @@map("combo_item_option_size_branches")
}

model Promotion {
  id        String @id @default(uuid())
  foodicsId String @unique

  name          String
  nameLocalized String?  @map("name_localized")
  isActive      Boolean? @map("is_active")

  type PromotionType @map("type")

  fromDate DateTime @map("from_date") @db.Date
  toDate   DateTime @map("to_date") @db.Date
  fromTime Int      @map("from_time") // confirmed integer hour (0-23) from real sample
  toTime   Int      @map("to_time")

  isSat Boolean? @map("is_sat")
  isSun Boolean? @map("is_sun")
  isMon Boolean? @map("is_mon")
  isTue Boolean? @map("is_tue")
  isWed Boolean? @map("is_wed")
  isThu Boolean? @map("is_thu")
  isFri Boolean? @map("is_fri")

  includeModifiers      Boolean?   @map("include_modifiers")
  targetQuantity        Int?       @map("target_quantity")
  rewardQuantity        Int?       @map("reward_quantity")
  rewardType            RewardType @map("reward_type") // single value, confirmed by sample
  rewardAmount          Float      @map("reward_amount") // single value, confirmed by sample
  maximumDiscountAmount Float      @map("maximum_discount_amount")

  // --- Relations (all plain many-to-many — every pivot in the sample has only 2 FKs) ---
  order       Order?
  products    Product[]  @relation("PromotionProducts")
  productTags Tag[]      @relation("PromotionProductTags")
  combos      Combo[]    @relation("PromotionCombos")
  categories  Category[] @relation("PromotionCategories")
  branches    Branch[]   @relation("BranchPromotions")

  customerTags Tag[] @relation("PromotionCustomerTags")

  rewardProducts             Product[]          @relation("PromotionRewardProducts")
  rewardProductTags          Tag[]              @relation("PromotionRewardProductTags")
  rewardCombos               Combo[]            @relation("PromotionRewardCombos")
  rewardCategories           Category[]         @relation("PromotionRewardCategories")
  orderProductPromotion      OrderProduct?      @relation("OrderProductPromotion")
  orderComboProductPromotion OrderComboProduct? @relation("OrderComboProductPromotion")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("promotions")
}

model Tag {
  id        String @id @default(uuid())
  foodicsId String @unique

  name          String
  nameLocalized String? @map("name_localized")
  type          TagType // see Tag Types enum below

  branches       Branch[]        @relation("BranchTags")
  products       Product[]       @relation("ProductTags")
  combos         Combo[]         @relation("ComboTags")
  devices        Device[]        @relation("DeviceTags")
  inventoryItems InventoryItem[] @relation("InventoryItemTags")
  suppliers      Supplier[]      @relation("SupplierTags")
  timedEvents    TimedEvent[]    @relation("TimedEventTags")

  // giftCardProducts        GiftCardProduct[] @relation("GiftCardProductTags")

  promotionProductTags       Promotion[] @relation("PromotionProductTags")
  promotionCustomerTags      Promotion[] @relation("PromotionCustomerTags")
  promotionRewardProductTags Promotion[] @relation("PromotionRewardProductTags")

  discountProductTags  Discount[]        @relation("DiscountProductTags")
  discountCustomerTags Discount[]        @relation("DiscountCustomerTags")
  giftCardProductTag   GiftCardProduct[] @relation("GiftCardProductTags") // pivot: {gift_card_product_id, tag_id} only -> plain many-to-many

  ordertags   Order[]    @relation("OrderTags")
  customerTag Customer[] @relation("CustomerTags") // sample shows {id} only, no pivot -> plain many-to-many

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("tags")
}

model TimedEvent {
  id        String @id @default(uuid())
  foodicsId String @unique

  name          String
  nameLocalized String?  @map("name_localized")
  type          Int // see Timed Event Types enum below
  value         Float
  priority      Int?
  isActive      Boolean? @map("is_active")

  fromDate DateTime @map("from_date") @db.Date
  toDate   DateTime @map("to_date") @db.Date
  fromTime String   @map("from_time") // time-of-day only (e.g. "09:00"), not a full timestamp
  toTime   String   @map("to_time")

  isSat Boolean? @map("is_sat")
  isSun Boolean? @map("is_sun")
  isMon Boolean? @map("is_mon")
  isTue Boolean? @map("is_tue")
  isWed Boolean? @map("is_wed")
  isThu Boolean? @map("is_thu")
  isFri Boolean? @map("is_fri")

  orderTypes OrderType @default(DELIVERY) // not includable -> plain codes, not a relation

  // --- Relations (all plain, no custom pivots) ---

  branches Branch[]   @relation("BranchTimedEvents")
  category Category[] @relation("CategoryTimedEvents")
  tags     Tag[]      @relation("TimedEventTags")
  product  Product[]  @relation("ProductTimedEvents")

  combo                  Combo[]        @relation("ComboTimedEvents") // pivot: {id} only -> plain
  orderProductTimedEvent OrderProduct[] @relation("OrderProductTimedEvents") // no pivot data shown -> plain relation

  orderComboProductTimedEvents OrderComboProduct[] @relation("OrderComboProductTimedEvents")

  // combos         ComboTimedEvents[]    
  // products       ProductTimedEvent[]   @relation("ProductTimedEvents")

  // categories     Category[]  @relation("CategoryTimedEvents")
  // priceTags      PriceTag[]  @relation("TimedEventPriceTags")
  // customerTags   Tag[]       @relation("TimedEventCustomerTags")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("timed_events")
}

model Discount {
  id        String @id @default(uuid())
  foodicsId String @unique

  name                String
  nameLocalized       String?   @map("name_localized")
  qualification       Int // see Discount Qualification enum below
  amount              Float
  minimumProductPrice Float?    @map("minimum_product_price")
  minimumOrderPrice   Float     @map("minimum_order_price")
  maximumAmount       Float?    @map("maximum_amount")
  isPercentage        Boolean   @map("is_percentage")
  isTaxable           Boolean?  @map("is_taxable")
  reference           String?   @unique
  orderTypes          OrderType @default(DELIVERY) // not `includable` -> not a relation, just a list of type codes

  // --- Relations ---
  products   Product[]  @relation("ProductDiscounts")
  combos     Combo[] // inverse of Combo.discounts... see note below
  branches   Branch[]   @relation("DiscountBranches")
  categories Category[] @relation("CategoryDiscounts")

  productTags               Tag[]              @relation("DiscountProductTags")
  customerTags              Tag[]              @relation("DiscountCustomerTags")
  Order                     Order?
  orderDiscount             OrderProduct?      @relation("OrderProductDiscount")
  orderComboDiscount        OrderCombo?        @relation("OrderComboDiscount")
  OrderComboProductDiscount OrderComboProduct? @relation("OrderComboProductDiscount")
  coupon                    Coupon?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("discounts")
}

model DeliveryZone {
  id        String @id @default(uuid())
  foodicsId String @unique

  name          String
  nameLocalized String? @map("name_localized")
  reference     String? @unique
  coordinates   Json? // array of lat/lng points — no fixed shape given, so Json fits best

  // --- Relations ---

  branches        Branch[]         @relation("BranchDeliveryZones")
  customerAddress CustomerAddress?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("delivery_zones")
}

model TaxGroup {
  id        String @id @default(uuid())
  foodicsId String @unique

  name          String
  nameLocalized String?   @map("name_localized")
  // --- Relations ---
  taxes         Tax[]     @relation("TaxGroupTaxes")
  product       Product[]
  charge        Charge?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  branch         Branch[]
  modifierOption ModifierOption[]

  @@map("tax_groups")
}

model Tax {
  id        String @id @default(uuid())
  foodicsId String @unique

  name          String
  nameLocalized String? @map("name_localized")
  rate          Float // the tax rate — required, updatable

  // Add tax-specific fields here (e.g. rate, type) once you share the Tax spec
  taxGroups                    TaxGroup[]                  @relation("TaxGroupTaxes")
  orderTax                     OrderTax?                   @relation("OrderTaxes")
  orderProductTax              OrderProductTax?            @relation("OrderProductTaxes")
  orderProductOptionTaxes      OrderProductOptionTax?      @relation("OrderProductOptionTaxes")
  orderChargeTaxes             OrderChargeTax?             @relation("OrderChargeTaxes")
  orderComboProductTaxes       OrderComboProductTax?       @relation("OrderComboProductTaxes")
  orderComboProductOptionTaxes OrderComboProductOptionTax? @relation("OrderComboProductOptionTaxes")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("taxes")
}

model Charge {
  id        String @id @default(uuid())
  foodicsId String @unique

  name          String
  nameLocalized String?     @map("name_localized")
  type          ChargeType? @map("type")
  orderTypes    OrderType[] @map("order_types")
  isAutoApplied Boolean?    @map("is_auto_applied")
  value         Float
  isOpenCharge  Boolean     @map("is_open_charge")

  // --- Relations ---
  taxGroupId  String?      @unique @map("tax_group_id")
  taxGroup    TaxGroup?    @relation(fields: [taxGroupId], references: [id])
  branches    Branch[]     @relation("BranchCharges")
  orderCharge OrderCharge?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("charges")
}

model Section {
  id        String @id @default(uuid())
  foodicsId String @unique

  name          String?
  nameLocalized String? @map("name_localized")

  // --- Relations ---
  branchId String @map("branch_id")
  branch   Branch @relation(fields: [branchId], references: [id])

  revenueCenter Json? @map("revenue_center") // embedded object, not a relation

  tables Table[] // inverse of Table.section

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("sections")
}

model Table {
  id        String @id @default(uuid())
  foodicsId String @unique

  name                String?
  status              TableStatus
  seats               Int?
  acceptsReservations Boolean?    @map("accepts_reservations")
  // --- Relations ---

  sectionId String?  @map("section_id")
  section   Section? @relation(fields: [sectionId], references: [id])
  order     Order?

  revenueCenter Json? @map("revenue_center") // embedded object, not a relation

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("tables")
}

model Device {
  id        String @id @default(uuid())
  foodicsId String @unique

  name             String
  code             String?
  inUse            Boolean?   @map("in_use")
  reference        String     @unique
  type             DeviceType
  latitude         Float?
  longitude        Float?
  isBlocked        Boolean?   @map("is_blocked")
  localSettings    Json?      @map("local_settings")
  model            String?
  build            Int?
  appVersion       String?    @map("app_version")
  systemVersion    String?    @map("system_version")
  settings         Json?
  isOnlineReceiver Boolean?   @map("is_online_receiver")
  lastSyncAt       DateTime?  @map("last_sync_at")
  lastSeenAt       DateTime?  @map("last_seen_at")
  lastOrderAt      DateTime?  @map("last_order_at")

  // --- Relations ---

  branchId String @map("branch_id")
  branch   Branch @relation(fields: [branchId], references: [id])

  revenueCenter Json? @map("revenue_center") // embedded object, not a relation (same pattern as Section/Table)

  group String? @map("group") // spec types this as `string`, not `object`/`array` — kept as plain field, not a relation, despite `includable` tag

  tags Tag[] @relation("DeviceTags") // pivot shown is plain {device_id, tag_id} -> no custom attrs\

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("devices")
}

//  {<---------- Order Model ---------->}
model Order {
  id        String @id @default(uuid())
  foodicsId String @unique

  reference                  String?
  referenceX                 String?   @map("reference_x")
  appId                      String?   @map("app_id")
  number                     Int?
  type                       OrderType // reused existing enum
  source                     Int // Order Source enum — values not yet given
  status                     Int // Order Status enum — values not yet given
  deliveryStatus             Int?      @map("delivery_status")
  guests                     Int
  kitchenNotes               String?   @map("kitchen_notes")
  customerNotes              String?   @map("customer_notes")
  businessDate               DateTime  @map("business_date") @db.Date
  subtotalPrice              Float     @map("subtotal_price")
  discountAmount             Float     @map("discount_amount")
  roundingAmount             Float     @map("rounding_amount")
  totalPrice                 Float     @map("total_price")
  taxExclusiveDiscountAmount Float     @map("tax_exclusive_discount_amount")
  delayInSeconds             Int?      @map("delay_in_seconds")
  discountType               Int       @map("discount_type") // Discount Type enum — values not yet given

  meta                    Json? // arbitrary nested integration data (foodics.*, uuid, joined_orders, etc.) — stays JSON, not modeled field-by-field
  taxReportingTransaction Json? @map("tax_reporting_transaction") // no field spec given yet — placeholder JSON pending spec

  // --- Relations ---

  branchId String @map("branch_id")
  branch   Branch @relation(fields: [branchId], references: [id])

  tableId String? @unique @map("table_id")
  table   Table?  @relation(fields: [tableId], references: [id])

  creatorId String @unique @map("creator_id")
  creator   User   @relation("OrderCreator", fields: [creatorId], references: [id])

  closerId String? @unique @map("closer_id")
  closer   User?   @relation("OrderCloser", fields: [closerId], references: [id])

  driverId String? @unique @map("driver_id")
  driver   User?   @relation("OrderDriver", fields: [driverId], references: [id])

  // self-relation: an order can reference its original order (returns/splits)
  originalOrderId String? @map("original_order_id")
  originalOrder   Order?  @relation("OrderReturns", fields: [originalOrderId], references: [id])
  relatedOrders   Order[] @relation("OrderReturns")

  customerId String?   @unique @map("customer_id")
  customer   Customer? @relation(fields: [customerId], references: [id])

  customerAddressId String?          @unique @map("customer_address_id")
  customerAddress   CustomerAddress? @relation(fields: [customerAddressId], references: [id])

  discountId String?   @unique @map("discount_id")
  discount   Discount? @relation(fields: [discountId], references: [id])

  couponId String? @unique @map("coupon_id")
  coupon   Coupon? @relation(fields: [couponId], references: [id])

  giftCardId String?   @unique @map("gift_card_id")
  giftCard   GiftCard? @relation(fields: [giftCardId], references: [id])

  promotionId String?    @unique @map("promotion_id")
  promotion   Promotion? @relation(fields: [promotionId], references: [id])

  revenueCenter Json? @map("revenue_center") // same JSON-snapshot pattern as Section/Table/Device

  payments OrderPayment[]
  charges  OrderCharge[]
  taxes    OrderTax[]
  products OrderProduct[]
  combos   OrderCombo[]
  tags     Tag[]          @relation("OrderTags") // no pivot shown -> plain many-to-many

  openedAt          DateTime? @map("opened_at")
  dueAt             DateTime? @map("due_at")
  kitchenReceivedAt DateTime? @map("kitchen_received_at")
  kitchenDoneAt     DateTime? @map("kitchen_done_at")
  driverAssignedAt  DateTime? @map("driver_assigned_at")
  dispatchedAt      DateTime? @map("dispatched_at")
  driverCollectedAt DateTime? @map("driver_collected_at")
  deliveredAt       DateTime? @map("delivered_at")
  closedAt          DateTime? @map("closed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("orders")
}

// Top-level order taxes — pivot: {amount, rate, tax_exclusive_discount_amount}
model OrderTax {
  id                         String @id @default(uuid())
  orderId                    String @map("order_id")
  order                      Order  @relation(fields: [orderId], references: [id])
  taxId                      String @unique @map("tax_id")
  tax                        Tax    @relation("OrderTaxes", fields: [taxId], references: [id])
  amount                     Float
  rate                       Float
  taxExclusiveDiscountAmount Float? @map("tax_exclusive_discount_amount")

  @@map("order_taxes")
}

model OrderProduct {
  id                         String    @id @default(uuid())
  discountType               Int?      @map("discount_type")
  quantity                   Int
  returnedQuantity           Int?      @map("returned_quantity")
  unitPrice                  Float     @map("unit_price")
  discountAmount             Float     @map("discount_amount")
